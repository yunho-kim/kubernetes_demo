#!/usr/bin/env bash
# sbfl-coverage <CVE-ID> — faithful Defects4J-style coverage + SBFL for one CVE.
#
# Minimal pair (buggy = fixed release with the fix reverse-applied) is run
# against HAProxy's own reg-tests/ suite via vtest, INSIDE kind pods. Tests are
# classified the Defects4J way (trigger = fail-on-buggy & pass-on-fixed; passing
# = pass-on-both), per-test line coverage is collected on the buggy build, and
# the result is emitted as GZoltar artifacts + Defects4J metadata, then ranked.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/../lib/sbfl.sh"

PID="${1:?usage: sbfl-coverage <CVE-ID>}"
CVE_DIR="$SBFL_ROOT/cves/$PID"
PATCH="$SBFL_ROOT/patches/$PID.fix.patch"
FIXVER="$(cve_fixed_version "$PID")"
SRC="/build/haproxy-$FIXVER"
B="haproxy-sbfl:${PID}-buggy"; F="haproxy-sbfl:${PID}-fixed"
RESULTS="$SBFL_ROOT/results/$PID"; PROJ="$SBFL_ROOT/projects/$PID"
PB=sbfl-buggy; PF=sbfl-fixed

docker image inspect "$B" "$F" >/dev/null 2>&1 || die "missing $B/$F (build with images/Dockerfile.minpair)"
[[ -f "$PATCH" ]] || die "missing fix patch $PATCH"

rm -rf "$RESULTS"; mkdir -p "$RESULTS/buggy" "$RESULTS/fixed"
MODFILES="$(grep '^+++ b/' "$PATCH" | sed 's#^+++ b/##')"
log "CVE=$PID  fixed=$FIXVER  modified files: $(echo $MODFILES | tr '\n' ' ')"

# ---- ground truth: diff buggy vs fixed for each modified file ----
log "computing ground truth (minimal-pair diff)"
gt_parts=()
for f in $MODFILES; do
  docker run --rm "$B" cat "$SRC/$f" > /tmp/gt_buggy 2>/dev/null
  docker run --rm "$F" cat "$SRC/$f" > /tmp/gt_fixed 2>/dev/null
  python3 "$HERE/gtdiff.py" /tmp/gt_buggy /tmp/gt_fixed "$f" > "/tmp/gt_$(echo "$f" | tr / _).json"
  gt_parts+=("/tmp/gt_$(echo "$f" | tr / _).json")
done
python3 - "$RESULTS/ground_truth.json" "${gt_parts[@]}" <<'PY'
import json, sys
out = sys.argv[1]; files, lines, omis = [], [], False
for p in sys.argv[2:]:
    d = json.load(open(p)); files += d["files"]; lines += d["lines"]; omis = omis or d.get("fault_of_omission", False)
json.dump({"files": sorted(set(files)), "lines": lines, "fault_of_omission": omis}, open(out, "w"))
print("  ground-truth lines:", [(l["file"], l["line"]) for l in lines])
PY

# ---- cluster + load images + pods ----
cluster_up
log "loading images into kind (may take ~1m each)"
kind load docker-image "$B" --name "$KIND_CLUSTER" >/dev/null
kind load docker-image "$F" --name "$KIND_CLUSTER" >/dev/null
deploy_pod() {   # <pod> <image> [SYS_PTRACE]
  local pod="$1" img="$2" cap="${3:-}"
  k delete pod "$pod" --ignore-not-found --now >/dev/null 2>&1 || true
  k apply -f - >/dev/null <<EOF
apiVersion: v1
kind: Pod
metadata: { name: $pod }
spec:
  containers:
  - name: haproxy
    image: $img
    imagePullPolicy: Never
    command: ["sleep", "infinity"]
$( [[ "$cap" == SYS_PTRACE ]] && printf '    securityContext: { capabilities: { add: ["SYS_PTRACE"] } }' )
EOF
}
deploy_pod "$PB" "$B" SYS_PTRACE
deploy_pod "$PF" "$F"
k wait --for=condition=Ready "pod/$PB" "pod/$PF" --timeout=180s >/dev/null

cp_in()  { k exec -i "$1" -- sh -c "cat > $3" < "$2"; }

# ---- build the suite list (globs + crafted trigger) inside the pods ----
GLOBS="$(grep -vE '^\s*#|^\s*$' "$CVE_DIR/regtests.txt" | tr '\n' ' ')"
for pod in "$PB" "$PF"; do
  cp_in "$pod" "$HERE/../images/runsuite.sh" /runsuite.sh
  if [[ -f "$CVE_DIR/trigger.vtc" ]]; then
    cp_in "$pod" "$CVE_DIR/trigger.vtc" "$SRC/reg-tests/_sbfl_trigger.vtc"
  fi
  k exec "$pod" -- sh -c "cd $SRC && ls $GLOBS reg-tests/_sbfl_trigger.vtc 2>/dev/null" > "/tmp/list_$pod" || true
  cp_in "$pod" "/tmp/list_$pod" /tmp/list.txt
done
log "suite: $(wc -l < "/tmp/list_$PB") candidate tests"

COV_TICK=""
[[ -f "$CVE_DIR/build.env" ]] && source "$CVE_DIR/build.env"   # may set COV_TICK
log "running suite on BUGGY (with coverage${COV_TICK:+, COV_TICK=$COV_TICK})"
k exec "$PB" -- env ${COV_TICK:+COV_TICK=$COV_TICK} bash /runsuite.sh "$SRC" /tmp/list.txt /tmp/out cov 2>&1 | tail -1
log "running suite on FIXED (outcomes only)"
k exec "$PF" -- bash /runsuite.sh "$SRC" /tmp/list.txt /tmp/out outcome 2>&1 | tail -1

kubectl --context "$KCTX" cp "$PB:/tmp/out/." "$RESULTS/buggy/" >/dev/null
kubectl --context "$KCTX" cp "$PF:/tmp/out/." "$RESULTS/fixed/" >/dev/null

# ---- classify + GZoltar artifacts ----
log "classifying tests + emitting GZoltar artifacts"
python3 "$HERE/assemble.py" "$RESULTS"

# ---- Defects4J-style metadata layout ----
mkdir -p "$PROJ/patches" "$PROJ/trigger_tests" "$PROJ/relevant_tests" \
         "$PROJ/modified_classes" "$PROJ/loaded_classes"
cp "$PATCH" "$PROJ/patches/1.fix.patch"
printf '1,%s~fix-reverted,%s\n' "$FIXVER" "$FIXVER" > "$PROJ/commit-db"
python3 - "$RESULTS/classification.json" "$PROJ" <<'PY'
import json, sys
c = json.load(open(sys.argv[1])); P = sys.argv[2]
open(f"{P}/trigger_tests/1", "w").write("\n".join(c["triggers"]) + "\n")
open(f"{P}/relevant_tests/1", "w").write("\n".join(c["relevant"]) + "\n")
open(f"{P}/loaded_classes/1", "w").write("\n".join(c["loaded"]) + "\n")
PY
echo "$MODFILES" > "$PROJ/modified_classes/1"

echo
log "=============== SBFL ranking ($PID) ==============="
python3 "$HERE/sbfl-rank" -r "$RESULTS" --top 15 --json-out "$RESULTS/ranking.json"
