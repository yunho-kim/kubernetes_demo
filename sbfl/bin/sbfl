#!/usr/bin/env bash
# sbfl — Defects4J-style CLI for the faithful HAProxy SBFL benchmark.
#
#   sbfl pids                     list CVE bug IDs
#   sbfl info     -p <CVE>        metadata (version, patch, modified files, result)
#   sbfl compile [-p <CVE>]       build the minimal-pair coverage images (all if none)
#   sbfl coverage -p <CVE>        run suite -> per-test coverage -> classify -> rank
#   sbfl sbfl     -p <CVE>        re-rank existing coverage (suspiciousness + EXAM)
#   sbfl run     [-p <CVE>]       compile (if needed) + coverage, then summary
#   sbfl summary                  fault-rank table across results/
#   sbfl clean                    delete the 'sbfl' kind cluster
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/../lib/sbfl.sh"

ALL_CVES=(CVE-2021-40346 CVE-2022-0711 CVE-2023-45539)
argp() { p=""; while [[ $# -gt 0 ]]; do [[ "$1" == -p ]] && { p="$2"; shift 2; } || shift; done; printf '%s' "$p"; }

cmd_pids() { printf '%s\n' "${ALL_CVES[@]}"; }

cmd_info() {
  local pid; pid="$(argp "$@")"; [[ -n "$pid" ]] || die "info -p <CVE>"
  printf 'pid          : %s\n' "$pid"
  printf 'fixed version: %s\n' "$(cve_fixed_version "$pid")"
  printf 'buggy        : %s (fixed release with the fix reverse-applied)\n' "haproxy-sbfl:$pid-buggy"
  printf 'fix patch    : sbfl/patches/%s.fix.patch\n' "$pid"
  printf 'modified     : %s\n' "$(grep '^+++ b/' "$SBFL_ROOT/patches/$pid.fix.patch" | sed 's#^+++ b/##' | tr '\n' ' ')"
  local rj="$SBFL_ROOT/results/$pid/ranking.json"
  if [[ -f "$rj" ]]; then
    python3 - "$rj" "$SBFL_ROOT/results/$pid/classification.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1])); c = json.load(open(sys.argv[2]))
fr = d["formulas"]["ochiai"].get("fault_rank")
print("triggers     :", ", ".join(c["triggers"]))
print("tests (f/p)  : %d / %d" % (len(d["failing"]), len(d["passing"])))
print("components   :", d["n_lines"])
if fr: print("fault rank   : %s%s of %d  (Ochiai, EXAM %.4f)" %
             (fr[0], "" if fr[1]==fr[0] else f"-{fr[1]}", fr[2], d["formulas"]["ochiai"]["exam"]))
PY
  else
    printf 'result       : (not run yet — sbfl coverage -p %s)\n' "$pid"
  fi
}

cmd_compile() {
  local pid; pid="$(argp "$@")"
  if [[ -n "$pid" ]]; then "$HERE/../images/build-minpair.sh" "$pid"
  else "$HERE/../images/build-minpair.sh"; fi
}

cmd_coverage() { local pid; pid="$(argp "$@")"; [[ -n "$pid" ]] || die "coverage -p <CVE>"; "$HERE/sbfl-coverage" "$pid"; }
cmd_sbfl()     { local pid; pid="$(argp "$@")"; [[ -n "$pid" ]] || die "sbfl -p <CVE>"
                 python3 "$HERE/sbfl-rank" -r "$SBFL_ROOT/results/$pid" --top 15 --json-out "$SBFL_ROOT/results/$pid/ranking.json"; }

cmd_run() {
  local pid; pid="$(argp "$@")"
  local cves=("$pid"); [[ -z "$pid" ]] && cves=("${ALL_CVES[@]}")
  for c in "${cves[@]}"; do
    docker image inspect "haproxy-sbfl:$c-buggy" >/dev/null 2>&1 || "$HERE/../images/build-minpair.sh" "$c"
    "$HERE/sbfl-coverage" "$c"
  done
  echo; log "=============== SUMMARY ==============="; cmd_summary
}

cmd_summary() {
  python3 - "$SBFL_ROOT/results" <<'PY'
import json, os, sys
root = sys.argv[1]; rows = []
for pid in sorted(os.listdir(root)) if os.path.isdir(root) else []:
    rj = os.path.join(root, pid, "ranking.json")
    if not os.path.exists(rj): continue
    d = json.load(open(rj)); och = d["formulas"].get("ochiai", {}); fr = och.get("fault_rank")
    rank = (f"{fr[0]}" + ("" if fr[1]==fr[0] else f"-{fr[1]}")) if fr else "NOT FOUND"
    exam = f"{och.get('exam'):.4f}" if och.get("exam") is not None else "-"
    rows.append((pid, f"{len(d['failing'])}/{len(d['passing'])}", d.get("n_lines"), rank, exam))
w = max([len(r[0]) for r in rows] + [8]) if rows else 8
print(f"{'CVE':<{w}}  tests(f/p)  lines  ochiai-rank   EXAM"); print("-"*(w+38))
for pid, tp, nl, rank, exam in rows:
    print(f"{pid:<{w}}  {tp:>9}  {str(nl):>5}  {rank:>11}   {exam}")
PY
}

[[ $# -ge 1 ]] || die "usage: sbfl {pids|info|compile|coverage|sbfl|run|summary|clean} ..."
sub="$1"; shift || true
case "$sub" in
  pids)     cmd_pids ;;
  info)     cmd_info "$@" ;;
  compile)  cmd_compile "$@" ;;
  coverage) cmd_coverage "$@" ;;
  sbfl|rank) cmd_sbfl "$@" ;;
  run)      cmd_run "$@" ;;
  summary)  cmd_summary ;;
  clean)    cluster_down ;;
  *) die "unknown subcommand: $sub" ;;
esac
