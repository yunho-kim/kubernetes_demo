# Pins of framework/lib/pyenv.sh (sourced), which builds every Python adapter's venv.
#
# uv: a uv on PATH is used when it is at least UV_MIN_VERSION; otherwise pyenv.sh downloads
# this static release (GitHub release asset, checked against UV_SHA256) into
# framework/.uv/<UV_VERSION>/ — no root, nothing outside the repository.
UV_MIN_VERSION=0.9.18
UV_VERSION=0.9.18
UV_URL=https://github.com/astral-sh/uv/releases/download/0.9.18/uv-x86_64-unknown-linux-musl.tar.gz
UV_SHA256=a55ae2d0d53c8f6541bb4d6afc95857ff33a97de8f1d23e9d09acdcb865c4a00
# Platform the requirements.lock files are resolved for (a tool may override it with
# PYTHON_LOCK_PLATFORM in its versions.env). manylinux_2_28 = glibc >= 2.28: the locked
# wheels of torch, numpy 2.5, greenlet … exist for it, not for manylinux2014.
PYTHON_LOCK_PLATFORM_DEFAULT=x86_64-manylinux_2_28
# The only package index (written into every lock; uv ignores pip.conf).
PYPI_INDEX_URL=https://pypi.org/simple
