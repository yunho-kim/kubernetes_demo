#!/usr/bin/env bash
# cvebench-coverage <pid> <bid> — collect per-test line coverage for one bug and
# classify the suite the Defects4J way, then emit GZoltar artifacts + metadata.
# Invoked by `cvebench coverage`. The project module (p_coverage_suite) runs the
# suite against the minimal pair; trigger = fail-on-buggy & pass-on-fixed.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/../lib/cvebench.sh"

PID="${1:?usage: cvebench-coverage <pid> <bid>}"; BID="${2:?need bid}"
load_project "$PID"
PDIR="$(proj_dir "$PID")"
FIXVER="$(bug_fixedver "$PID" "$BID")"; SRC="$(bug_srcdir "$PID" "$BID")"
B="$(bug_image "$PID" "$BID" buggy)"; F="$(bug_image "$PID" "$BID" fixed)"
R="$RESULTS_ROOT/$PID-$BID"

docker image inspect "$B" "$F" >/dev/null 2>&1 || die "missing images (cvebench compile -p $PID -b $BID)"
# start the coverage artifacts afresh; keep apr/ and the other tools' fl/ results (expensive LLM runs)
rm -rf "$R/buggy" "$R/fixed" "$R/gzoltar" "$R/fl/sbfl" \
       "$R"/{tests,classification,ground_truth,ground_truth_raw}.json
mkdir -p "$R/buggy" "$R/fixed"
MODFILES="$(bug_modified_files "$PID" "$BID")"
log "$PID-$BID ($(bug_cve "$PID" "$BID"))  fixed=$FIXVER  modified: $(echo $MODFILES | tr '\n' ' ')"

# ---- ground truth: diff buggy vs fixed for each modified file ----
log "computing ground truth (minimal-pair diff)"
gt=()
for f in $MODFILES; do
  docker run --rm "$B" cat "$SRC/$f" > /tmp/gt_b 2>/dev/null
  docker run --rm "$F" cat "$SRC/$f" > /tmp/gt_f 2>/dev/null
  python3 "$HERE/gtdiff.py" /tmp/gt_b /tmp/gt_f "$f" > "/tmp/gt_$(echo "$f"|tr / _).json"
  gt+=("/tmp/gt_$(echo "$f"|tr / _).json")
done
python3 - "$R/ground_truth.json" "${gt[@]}" <<'PY'
import json,sys
out=sys.argv[1]; files=[]; lines=[]; om=False
for p in sys.argv[2:]:
    d=json.load(open(p)); files+=d["files"]; lines+=d["lines"]; om=om or d.get("fault_of_omission",False)
json.dump({"files":sorted(set(files)),"lines":lines,"fault_of_omission":om},open(out,"w"))
PY

# ---- run the suite on both variants (project-specific) ----
p_coverage_suite "$R"

log "classifying + GZoltar artifacts"
python3 "$HERE/assemble.py" "$R"

# ---- Defects4J metadata (per-bug files under the project) ----
echo "$MODFILES" > "$PDIR/modified_classes/$BID"
python3 - "$R/classification.json" "$PDIR" "$BID" <<'PY'
import json,sys
c=json.load(open(sys.argv[1])); P,b=sys.argv[2],sys.argv[3]
open(f"{P}/trigger_tests/{b}","w").write("\n".join(c["triggers"])+"\n")
open(f"{P}/relevant_tests/{b}","w").write("\n".join(c["relevant"])+"\n")
open(f"{P}/loaded_classes/{b}","w").write("\n".join(c["loaded"])+"\n")
PY

echo; log "=============== SBFL ranking ($PID-$BID) ==============="
python3 "$HERE/sbfl-rank" -r "$R" --top 15 -o "$R/fl/sbfl"
