#!/usr/bin/env python3
"""sbfl-rank — Spectrum-Based Fault Localization over per-test line coverage.

Defects4J-style: given per-test line coverage (gcovr JSON) labelled pass/fail,
build the spectrum (ef/ep/nf/np per source line), compute suspiciousness with
a family of SBFL formulas, rank lines, and score the ranking against the
ground-truth patched lines (the lines the real upstream fix touched).

Layout consumed (produced by `cvebench coverage`):
  <results>/tests.json          [{"name","outcome":"pass|fail","coverage":"buggy/coverage/<f>.json"}]
  <results>/buggy/coverage/*.json   compact per-test coverage
  <results>/ground_truth.json    {"lines":[{"file","line"}], "files":[...]}

Usage:
  sbfl-rank -r <results-dir> [--formula ochiai|...|all] [--top 25] [-o <out-dir>]

Formulas (ef = failing tests covering the line, ep = passing tests covering it,
nf/np = the rest; F = ef+nf, P = ep+np):
  ochiai      ef / sqrt(F * (ef+ep))                       Abreu et al., TAIC PART 2007
  tarantula   (ef/F) / (ef/F + ep/P)                       Jones & Harrold, ASE 2005
  jaccard     ef / (F + ep)                                Chen et al., DSN 2002
  dstar       ef^2 / (ep + nf)         (D*, *=2)           Wong et al., TR 2014
  op2         ef - ep / (P + 1)        (Naish2)            Naish et al., TOSEM 2011
  barinel     1 - ep / (ep + ef)       (single-fault form) Abreu et al., ASE 2009
  gp13        ef * (1 + 1 / (2*ep + ef))                   Yoo, SSBSE 2012
  kulczynski2 (ef/F + ef/(ef+ep)) / 2                      Naish et al., TOSEM 2011
  ample       | ef/F - ep/P |                              Dallmeier et al., ECOOP 2005
"""
import argparse
import math
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import flcommon as fl  # noqa: E402

FORMULAS = ("ochiai", "tarantula", "jaccard", "dstar", "op2", "barinel",
            "gp13", "kulczynski2", "ample")


def suspiciousness(formula, ef, ep, nf, np_):
    F = ef + nf          # total failing
    P = ep + np_         # total passing
    if formula == "ochiai":
        d = math.sqrt(F * (ef + ep))
        return ef / d if d else 0.0
    if formula == "tarantula":
        a = ef / F if F else 0.0
        b = ep / P if P else 0.0
        return a / (a + b) if (a + b) else 0.0
    if formula == "jaccard":
        d = F + ep
        return ef / d if d else 0.0
    if formula == "dstar":          # D* with * = 2
        d = ep + nf
        return (ef * ef) / d if d else (float("inf") if ef else 0.0)
    if formula == "op2":
        return ef - ep / (P + 1)
    if formula == "barinel":
        d = ep + ef
        return 1.0 - ep / d if d else 0.0
    if formula == "gp13":
        d = 2 * ep + ef
        return ef * (1.0 + 1.0 / d) if d else 0.0
    if formula == "kulczynski2":
        a = ef / F if F else 0.0
        b = ef / (ef + ep) if (ef + ep) else 0.0
        return (a + b) / 2.0
    if formula == "ample":
        a = ef / F if F else 0.0
        b = ep / P if P else 0.0
        return abs(a - b)
    raise ValueError(formula)


def rank(spectrum, formula):
    scored = [(e, suspiciousness(formula, *spectrum[e])) for e in spectrum]
    # suspiciousness desc; deterministic tie-break by (file, line)
    scored.sort(key=lambda x: (-x[1], x[0][0], x[0][1]))
    return scored


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-r", "--results", required=True)
    ap.add_argument("--formula", choices=FORMULAS + ("all",), default="all")
    ap.add_argument("--top", type=int, default=25)
    ap.add_argument("-o", "--out-dir", default=None,
                    help="write <out-dir>/ranking.json (default: <results>/fl/sbfl)")
    ap.add_argument("--json-out", default=None, help=argparse.SUPPRESS)  # legacy
    args = ap.parse_args()

    spectrum, fnames, pnames = fl.build_spectrum(args.results)
    gt = fl.load_ground_truth(args.results)

    print(f"# SBFL  results={args.results}")
    print(f"#   failing tests ({len(fnames)}): {', '.join(fnames)}")
    print(f"#   passing tests ({len(pnames)}): {', '.join(pnames)}")
    print(f"#   instrumented lines in spectrum: {len(spectrum)}")
    if gt:
        print(f"#   ground-truth lines: {sorted(gt['lines'])}")
    print()

    def detail(e):
        ef, ep, nf, np_ = spectrum[e]
        return f"(ef={ef} ep={ep} nf={nf} np={np_})"

    formulas = FORMULAS if args.formula == "all" else (args.formula,)
    out = {}
    for formula in formulas:
        entry = fl.report(formula, rank(spectrum, formula), gt, args.top, detail)
        for row in entry["top"]:
            row["spectrum"] = list(spectrum[(row["file"], row["line"])])
        out[formula] = entry

    out_dir = args.out_dir or os.path.join(args.results, "fl", "sbfl")
    path = fl.write_ranking(out_dir, "sbfl", fnames, pnames, len(spectrum), out)
    if args.json_out and os.path.abspath(args.json_out) != os.path.abspath(path):
        import shutil
        shutil.copy(path, args.json_out)


if __name__ == "__main__":
    main()
