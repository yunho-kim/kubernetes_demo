# FAngelix (Yi & Ismayilzada, IST 2022; an extension of Angelix) is distributed as a Docker
# image with its LLVM 2.9 / 3.7, KLEE, Z3 and Java synthesizer toolchain; the adapter runs it
# unchanged in a derived image that only adds VTest (HAProxy's reg-test runner).
FANGELIX_IMAGE=jayyi/fangelix:2021-Nov-09
FANGELIX_IMAGE_DIGEST=sha256:5e461a8d16fd18e9db4664023197c41bb65064776470a1ae336c14fe84954e22
FANGELIX_REPO=https://github.com/jyi/fangelix
FANGELIX_COMMIT=e06a128   # /fangelix in the image (2021-11-09)
# VTest at the commit the benchmark's HAProxy images were built with.
VTEST_REPO=https://github.com/vtest/VTest
VTEST_COMMIT=f1c3426
