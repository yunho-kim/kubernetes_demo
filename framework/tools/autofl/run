#!/usr/bin/env python3
"""run — cvebench adapter for AutoFL (Kang, An, Yoo, FSE 2024), ported to C.

    run <results-dir> [-o <out-dir>] [--reps 5] [--budget 10] [--num-tests 1]
        [--model M] [--base-url URL] [--protocol tools|text] [--temperature T] [--fresh]

LLM endpoint: any OpenAI-compatible chat API with function/tool calling —
  OPENAI_BASE_URL (or --base-url), OPENAI_API_KEY, AUTOFL_MODEL (or --model).
  e.g. llama.cpp:  OPENAI_BASE_URL=http://127.0.0.1:8080/v1 AUTOFL_MODEL=<name> OPENAI_API_KEY=none
  Servers without tool calling: --protocol text (the model writes FUNCTION_CALL lines).

Pipeline
  1. cvebench checkout -v buggy -> <out-dir>/workdir ; failing-test snippets (the .vtc
     files) and their failure output (re-run in the buggy image, cached in failinfo.json)
  2. input.json: files/lines executed by failing tests (from the spectrum)
  3. .venv/bin/python autofl_agent.py : tree-sitter function index + R LLM runs
  4. scoring = upstream compute_score.py: each run spreads a vote of 1 over the
     functions it names; scores are divided by the number of runs; ties are broken by
     (number of failing tests covering the function, times the function was inspected)
     and then lexically. Function ranks are expanded to lines (all spectrum lines of a
     function share its rank -> best–worst range); `_op2tb` breaks the line tie by Op2.
     Functions not covered by a failing test (never indexed) rank last.
"""
import argparse
import collections
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
FW_ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
sys.path.insert(0, os.path.join(FW_ROOT, "lib"))
import flcommon as fl  # noqa: E402

VENV_PY = os.path.join(HERE, ".venv", "bin", "python")
CVEBENCH = os.path.join(FW_ROOT, "bin", "cvebench")


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def fail_info(pid, bid, version, vtc_path, vtc_text):
    """Re-run one failing test in the buggy image and keep vtest's failure lines."""
    img = f"cvebench:{pid}-{bid}-buggy"
    if sh(["docker", "image", "inspect", img]).returncode != 0:
        return "(failure output unavailable: buggy image not built — cvebench compile)"
    src = f"/build/haproxy-{version}"
    r = subprocess.run(["docker", "run", "--rm", "-i", "--cap-add=SYS_PTRACE", img, "bash", "-c",
                        f"cat > /t.vtc; cd {src} && HAPROXY_PROGRAM=/usr/local/bin/haproxy timeout 90 vtest /t.vtc 2>&1 "
                        "| grep -E '^(---- |\\*    top   TEST|#    top  TEST|\\*\\*\\*  [a-z0-9]+ +debug\\|.*(error|alert|Fatal))' | tail -20"],
                       input=vtc_text, capture_output=True, text=True)
    out = r.stdout.strip()
    return out if out else "(test failed without an expectation message; see vtest log)"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("results")
    ap.add_argument("-o", "--out-dir", default=None)
    ap.add_argument("--reps", type=int, default=5)
    ap.add_argument("--budget", type=int, default=10)
    ap.add_argument("--num-tests", type=int, default=1)
    ap.add_argument("--model", default=None)
    ap.add_argument("--base-url", default=None)
    ap.add_argument("--protocol", default="tools", choices=("tools", "text"))
    ap.add_argument("--temperature", type=float, default=None)
    ap.add_argument("--fresh", action="store_true", help="discard cached runs")
    ap.add_argument("--no-redact", action="store_true",
                    help="show CVE identifiers in the test to the model (default: replaced by CVE-XXXX-XXXXX, "
                         "so a model that memorised the advisory cannot short-cut localization)")
    ap.add_argument("--top", type=int, default=15)
    ap.add_argument("--metric", action="append", default=None, help=argparse.SUPPRESS)
    args = ap.parse_args()

    if not os.access(VENV_PY, os.X_OK):
        raise SystemExit(f"autofl venv missing — run {HERE}/prepare.sh (cvebench prepare -t autofl)")
    out_dir = args.out_dir or os.path.join(args.results, "fl", "autofl")
    os.makedirs(out_dir, exist_ok=True)
    name = os.path.basename(os.path.abspath(args.results)); pid, bid = name.rsplit("-", 1)
    pdir = os.path.join(FW_ROOT, "projects", pid)
    version = next(l.split(",")[2] for l in open(os.path.join(pdir, "commit-db")) if l.startswith(f"{bid},"))

    spectrum, failing, passing = fl.build_spectrum(args.results)
    F, P = len(failing), len(passing)
    gt = fl.load_ground_truth(args.results)
    tests = {t["name"]: t for t in json.load(open(os.path.join(args.results, "tests.json")))}
    vtc_of = {}
    for line in open(os.path.join(args.results, "buggy", "outcomes.txt")):
        p = line.split()
        if len(p) >= 3:
            vtc_of[p[0]] = p[2]

    # ---- buggy checkout
    wd = os.path.join(out_dir, "workdir")
    if not os.path.exists(os.path.join(wd, "cvebench.bug")):
        r = sh([CVEBENCH, "checkout", "-p", pid, "-b", bid, "-v", "buggy", "-w", wd])
        if r.returncode != 0:
            raise SystemExit("checkout failed: " + r.stderr)
    src = next(os.path.join(wd, d) for d in os.listdir(wd) if d.startswith("haproxy-"))

    # ---- failing tests: snippet + failure output (cached)
    cache_p = os.path.join(out_dir, "failinfo.json")
    cache = json.load(open(cache_p)) if os.path.exists(cache_p) else {}
    ftests = []
    for t in failing:
        vtc = vtc_of.get(t, "")
        if t == "_sbfl_trigger_vtc":
            path = os.path.join(pdir, "tests", bid, "trigger.vtc")
        else:
            path = os.path.join(src, vtc)
        try:
            snippet = open(path).read()
        except OSError:
            snippet = f"(test source {vtc} not available)"
        if not args.no_redact:
            snippet = re.sub(r"CVE-\d{4}-\d+", "CVE-XXXX-XXXXX", snippet)
        if t not in cache:
            print(f"[autofl] collecting failure output of {t}", flush=True)
            cache[t] = fail_info(pid, bid, version, vtc, snippet)
            json.dump(cache, open(cache_p, "w"), indent=1)
        ftests.append({"id": t, "name": vtc.replace("reg-tests/", "") or t, "snippet": snippet, "fail_info": cache[t]})

    # ---- files/lines executed by failing tests
    files = {}
    for t in failing:
        for f, ln in fl.load_coverage(os.path.join(args.results, tests[t]["coverage"])):
            d = files.setdefault(f, {"failing_lines": set(), "per_line_tests": collections.defaultdict(list)})
            d["failing_lines"].add(ln); d["per_line_tests"][str(ln)].append(t)
    inp = {"src": src, "failing_tests": ftests,
           "files": {f: {"failing_lines": sorted(d["failing_lines"]), "per_line_tests": dict(d["per_line_tests"])} for f, d in files.items()}}
    json.dump(inp, open(os.path.join(out_dir, "input.json"), "w"))
    print(f"[autofl] {name}: {F} failing tests, {len(files)} files executed by them", flush=True)

    # ---- agent runs (venv)
    if args.fresh:
        for f in os.listdir(os.path.join(out_dir, "runs")) if os.path.isdir(os.path.join(out_dir, "runs")) else []:
            os.remove(os.path.join(out_dir, "runs", f))
    cmd = [VENV_PY, os.path.join(HERE, "autofl_agent.py"), "--input", os.path.join(out_dir, "input.json"), "--out-dir", out_dir,
           "--reps", str(args.reps), "--budget", str(args.budget), "--num-tests", str(args.num_tests), "--protocol", args.protocol]
    if args.model: cmd += ["--model", args.model]
    if args.base_url: cmd += ["--base-url", args.base_url]
    if args.temperature is not None: cmd += ["--temperature", str(args.temperature)]
    r = subprocess.run(cmd)
    if r.returncode != 0:
        raise SystemExit("autofl agent failed")

    # ---- scoring (compute_score.py)
    functions = json.load(open(os.path.join(out_dir, "functions.json")))
    runs = [json.load(open(os.path.join(out_dir, "runs", f))) for f in sorted(os.listdir(os.path.join(out_dir, "runs")))]
    n_runs = len(runs)
    score = {}                                   # signature -> {"score","count"}
    seen = collections.Counter()
    for run in runs:
        matched = run.get("matched", {})
        for sig in matched:
            s = score.setdefault(sig, {"score": 0.0, "count": 0})
            s["count"] += 1; s["score"] += 1.0 / len(matched)
        for c in run.get("calls", []):           # functions the agent inspected (aux tie-break)
            if c["name"] in ("get_code_snippet", "get_comments"):
                try:
                    q = json.loads(c["arguments"]).get("signature", "")
                except Exception:
                    q = ""
                for f in functions:
                    if f["name"] and (q == f["signature"] or q.split("(")[0].split(":")[-1].strip("` ") == f["name"]):
                        seen[f["signature"]] += 1
    order = list(score) + sorted(f["signature"] for f in functions if f["signature"] not in score)
    ntests = {f["signature"]: f["num_failing_tests"] for f in functions}
    keys = []
    for i, sig in enumerate(order):
        s = score.get(sig, {"score": 0.0, "count": 0}); s["score"] /= max(n_runs, 1)
        aux = (ntests.get(sig, 0), 0 if s["count"] > 0 else seen[sig])
        keys.append((-s["score"], -aux[0], -aux[1], i, sig))
    ranked = [k[-1] for k in sorted(keys)]
    frank = {sig: r + 1 for r, sig in enumerate(ranked)}
    fmeta = {f["signature"]: f for f in functions}

    # ---- expand function ranks to lines
    line_rank = {}
    for sig, r in frank.items():
        f = fmeta[sig]
        for ln in range(f["begin_line"], f["end_line"] + 1):
            e = (f["file"], ln)
            if e in spectrum and (e not in line_rank or r < line_rank[e]):
                line_rank[e] = r
    bottom = len(ranked) + 1
    op2 = {e: s[0] - s[1] / (P + 1) for e, s in spectrum.items()}
    lo, hi = min(op2.values()), max(op2.values()); span = (hi - lo) or 1.0
    tb = {e: 0.999 * (v - lo) / span for e, v in op2.items()}
    plain = [(e, float(-line_rank.get(e, bottom))) for e in spectrum]
    plain.sort(key=lambda x: (-x[1], x[0][0], x[0][1]))
    hyb = [(e, s + 1e-6 * tb[e]) for e, s in plain]
    hyb.sort(key=lambda x: (-x[1], x[0][0], x[0][1]))

    ok_runs = sum(1 for r in runs if "error" not in r)
    print(f"# AutoFL  results={args.results}  runs={n_runs} (ok {ok_runs})  functions={len(functions)}")
    print(f"#   failing tests ({F}): {', '.join(failing)}")
    print("#   function ranking (top 10):")
    for sig in ranked[:10]:
        s = score.get(sig, {"score": 0.0, "count": 0})
        print(f"#     {frank[sig]:>3}. score={s['score']:.2f} votes={s['count']}/{n_runs} tests={ntests.get(sig, 0)}  {sig}")
    if gt:
        gfun = sorted({sig for sig, f in fmeta.items() if f["file"] in gt["files"] and any(f["begin_line"] <= ln <= f["end_line"] for ff, ln in gt["lines"] if ff == f["file"])})
        print(f"#   ground-truth lines: {sorted(gt['lines'])}  in functions: {[(g, frank[g]) for g in gfun]}")
    print()

    def detail(e):
        r = line_rank.get(e)
        if r is None:
            return "(function not covered by failing tests)"
        sig = ranked[r - 1]; s = score.get(sig, {"score": 0.0, "count": 0})
        return f"(fn#{r} {sig.split(':')[-1].split('(')[0]} score={s['score']:.2f} votes={s['count']})"
    formulas = {"autofl": fl.report("autofl", plain, gt, args.top, detail),
                "autofl_op2tb": fl.report("autofl_op2tb", hyb, gt, args.top, detail)}
    for f_ in formulas.values():
        f_["runs"] = n_runs; f_["ok_runs"] = ok_runs; f_["functions"] = len(functions)
        f_["function_ranking"] = [{"rank": frank[s], "signature": s, **score.get(s, {"score": 0.0, "count": 0})} for s in ranked[:50]]
    fl.write_ranking(out_dir, "autofl", failing, passing, len(spectrum), formulas)


if __name__ == "__main__":
    main()
