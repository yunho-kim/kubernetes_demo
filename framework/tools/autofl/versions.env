# Upstream reference for the AutoFL adapter (prompts and protocol were ported from this commit).
AUTOFL_REPO=https://github.com/coinse/autofl
AUTOFL_COMMIT=477190e2513b10be2b6079f6fc1ca132ab839e60
# Upstream defaults (runner.sh): R=5 repetitions, budget=10 steps, 1 failing test per run,
# gpt-3.5-turbo-0613, --show_line_number --allow_multi_predictions.
# Interpreter of the adapter's venv: exact CPython (python-build-standalone, installed by uv into
# framework/.python/ — never the system Python); framework/lib/pyenv.sh, docs/INTEGRATION.md 6.
PYTHON_VERSION=3.12.12
