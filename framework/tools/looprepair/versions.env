# Upstream of the LoopRepair adapter: its LLM stage (src/looprepair/LLMRepair.py, src/prompt/*)
# is used unchanged from this commit; CrashRepair's KLEE analyzer is replaced (see run).
LOOPREPAIR_REPO=https://github.com/Fino2020/LoopRepair
LOOPREPAIR_COMMIT=d71a9387e2e793b9764c007edd17bdebfb8c3c81
# Interpreter of the adapter's venv: exact CPython (python-build-standalone, installed by uv into
# framework/.python/ — never the system Python); framework/lib/pyenv.sh, docs/INTEGRATION.md 6.
# (upstream needs 3.9–3.11 for tree_sitter 0.20.x; the interpreter its venv was built with)
PYTHON_VERSION=3.11.14
