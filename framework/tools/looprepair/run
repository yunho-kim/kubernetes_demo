#!/usr/bin/env python3
"""run — cvebench APR adapter for LoopRepair (Ye et al., ICSE 2026).

    run <results-dir> <workdir> -o <out-dir> [--fl sbfl:ochiai] [--fl-top 3]
        [--model M] [--base-url URL] [--temperature T] [--no-json-schema]
        [--max-iterations 3] [--validation-minutes 45] [--iterative-minutes 180]
        [--patch-limit 10] [--no-stop-early] [--replay]

LLM endpoint: OpenAI-compatible chat API — OPENAI_BASE_URL (or --base-url), OPENAI_API_KEY,
LOOPREPAIR_MODEL (or --model; default gpt-4o-mini as upstream, or with a base URL the first
model the server lists). Upstream asks for JSON-schema structured output; servers without it:
--no-json-schema.

What is LoopRepair's and what is cvebench's
  * Unchanged from upstream (upstream/src/looprepair/LLMRepair.py + src/prompt/*, imported):
    the enclosing C function of a location (tree-sitter), the repair-sequence prediction
    (predict_sequence.txt), the function-level patch generation (repair_function.txt in the
    first round, iterative_function.txt afterwards), 5 samples per location, JSON-schema
    output parsed with json_repair; and the control flow of Scenario.repair / validate /
    iterative_repair: validate candidates (stop at the first acceptable one); otherwise
    re-analyse the first 20 evaluated, compiling, test-failing candidates, drop those whose
    bug type changed, rank by trace length ("impact lines"), take the top 2 as bases, and
    generate from each base's top-2 locations — for at most 3 iterations / 180 minutes.
  * Replaced (CrashRepair's KLEE/taint analyzer needs a crashing input; HAProxy's CVEs are
    logic bugs exposed by a failing vtest, so there is no crash to analyse):
      initial fix localization -> the top --fl-top lines of a cvebench FL ranking
                                  (results/<bug>/fl/<tool>/ranking.json; default sbfl:ochiai)
      bug type                 -> the trigger test's failure signature (vtest's failed
                                  expectations, observed values removed; or "no expectation")
      taint trace length       -> number of lines the trigger executes on the patched program
                                  (gcov, via the benchmark's runsuite.sh)
      re-localization          -> Ochiai over the patched program's trigger coverage (F = 1)
                                  and the original passing tests' coverage (lines mapped through
                                  the patch); ties: lines in patched files, nearest the change,
                                  then the original program's Ochiai
      crash test (+ fuzzer)    -> the trigger test, then the bug's relevant reg-tests
  * Candidates are kept as whole-file overlays relative to the buggy tree, so a candidate
    generated on top of a base patch is exported and re-applied as base + candidate (upstream
    re-applies such a diff alone, which cannot apply on the unpatched tree).
Building and testing happen in a container of the bug's buggy image (aprsandbox), whose tree is
already built; generation reads the functions from a host copy of the workdir.

Outputs: candidates/<id>.patch (acceptable patches — the harness validates them again),
generated/<id>.patch (every generated candidate), evaluations.jsonl, llm/NNNN.json
(every prompt and response), looprepair.json (summary), looprepair.log (upstream's log).
--replay: no LLM — the "model" returns the function with a comment added (and a trivial
sequence), so every candidate compiles and fails: a pipeline self-test of generation,
validation, re-analysis and iteration.
"""
import argparse
import collections
import difflib
import io
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tarfile
import time
import types
import uuid

HERE = os.path.dirname(os.path.abspath(__file__))
FW_ROOT = os.path.abspath(os.path.join(HERE, "..", ".."))
VENV = os.path.join(HERE, ".venv")
UPSTREAM_SRC = os.path.join(HERE, "upstream", "src", "looprepair")
sys.path.insert(0, os.path.join(FW_ROOT, "lib"))
import aprsandbox as sb  # noqa: E402
import flcommon as fl  # noqa: E402

COVER_SH = r"""
set -u
cp "$HAPROXY_SRC/haproxy" /usr/local/bin/haproxy.real
cp /cvebench/trigger.vtc "$HAPROXY_SRC/reg-tests/_sbfl_trigger.vtc"
echo reg-tests/_sbfl_trigger.vtc > /tmp/trig.txt
rm -rf /tmp/cov
COV_TICK="__COV_TICK__" bash /opt/cvebench-runsuite.sh "$HAPROXY_SRC" /tmp/trig.txt /tmp/cov cov >/tmp/cov.log 2>&1
cat /tmp/cov/coverage/_sbfl_trigger_vtc.json 2>/dev/null || echo '{"covered": {}}'
"""


def log(msg):
    print(f"[looprepair] {msg}", flush=True)


def signature(test_output):
    """Failure signature of a `cvebench-test trigger` run (the bug-type analogue)."""
    if re.search(r"^PASS ", test_output, re.M):
        return "pass"
    exp = sorted({re.sub(r"\s+", " ", re.sub(r"\([^)]*\)", "", l.strip()[5:])).strip()
                  for l in test_output.splitlines() if l.strip().startswith("---- ")})
    return "; ".join(exp) if exp else "fail: no expectation message (crash, hang or abort)"


class Sandbox:
    """Container of the buggy image: overlays are written into its (built) tree, rebuilt
    incrementally and tested; the tree is restored to the buggy version afterwards."""

    def __init__(self, bug, sbx, tree, time_limit):
        self.bug, self.tree = bug, tree
        sb.write_helpers(bug, sbx, keep_comments=True, redact=False)  # no LLM sees the test
        tick = ""
        benv = os.path.join(bug.pdir, "tests", bug.bid, "build.env")
        if os.path.exists(benv):
            m = re.search(r'^COV_TICK="?([^"\n]*)"?', open(benv).read(), re.M)
            tick = m.group(1) if m else ""
        self.cover_sh = COVER_SH.replace("__COV_TICK__", tick)
        self.cid = subprocess.run(
            ["docker", "run", "-d", "--rm", "--name", f"cvebench-lr-{uuid.uuid4().hex[:8]}", *sb.DOCKER_ARGS,
             "-v", f"{sbx}:/cvebench:ro",
             "-v", f"{os.path.join(bug.pdir, 'build', 'runsuite.sh')}:/opt/cvebench-runsuite.sh:ro",
             "-e", f"PATH=/cvebench/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
             "-w", bug.src, bug.image, "sleep", f"{time_limit + 3600}s"],
            capture_output=True, text=True, check=True).stdout.strip()
        r = self.sh(sb.setup_cmd(bug.src))
        if r.returncode != 0:
            raise SystemExit(f"sandbox setup failed: {r.stdout}{r.stderr}")

    def sh(self, cmd, timeout=900):
        return subprocess.run(["docker", "exec", self.cid, "bash", "-c", cmd],
                              capture_output=True, text=True, timeout=timeout)

    def put(self, files):
        buf = io.BytesIO()
        with tarfile.open(fileobj=buf, mode="w") as tf:
            for rel, text in files.items():
                data = text.encode("utf-8", "surrogateescape")
                ti = tarfile.TarInfo(rel)
                ti.size, ti.mtime, ti.mode = len(data), time.time(), 0o644
                tf.addfile(ti, io.BytesIO(data))
        subprocess.run(["docker", "exec", "-i", self.cid, "tar", "-x", "-m", "-C", self.bug.src],
                       input=buf.getvalue(), check=True, capture_output=True)

    def restore(self, overlay):
        self.put({rel: self.tree.pristine(rel) for rel in overlay})

    def evaluate(self, overlay, test_limit):
        """Upstream Scenario.evaluate: apply, rebuild, run the tests; revert."""
        out = {"compiles": False, "trigger": "not run", "relevant": "not run", "acceptable": False}
        try:
            self.put(overlay)
            if self.sh("cvebench-build").returncode != 0:
                return out
            out["compiles"] = True
            r = self.sh("cvebench-test trigger", timeout=test_limit + 120)
            out["signature"] = signature(r.stdout)
            out["trigger"] = "pass" if r.returncode == 0 else "fail"
            if r.returncode == 0:
                r = self.sh("cvebench-test all", timeout=10 * test_limit + 300)
                out["relevant"] = "pass" if r.returncode == 0 else "fail"
                out["failed_tests"] = [l.split()[1] for l in r.stdout.splitlines() if l.startswith("FAIL ")]
                out["acceptable"] = r.returncode == 0
            return out
        finally:
            self.restore(overlay)

    def trace(self, overlay):
        """Analysis substitute: the trigger's coverage and failure signature on the patched
        program. Returns (set of (file, line), signature) or (None, None) if it does not build."""
        try:
            self.put(overlay)
            if self.sh("cvebench-build").returncode != 0:
                return None, None
            sig = signature(self.sh("cvebench-test trigger").stdout)
            data = json.loads(self.sh(self.cover_sh, timeout=1800).stdout or '{"covered": {}}')
            covered = {(fl.norm(f), int(ln)) for f, lines in data.get("covered", {}).items() for ln in lines}
            return covered, sig
        finally:
            self.restore(overlay)

    def close(self):
        subprocess.run(["docker", "rm", "-f", self.cid], capture_output=True)


class Tree:
    """Host copy W of the buggy source tree (upstream generation reads functions from it)."""

    def __init__(self, workdir, root):
        src = next(os.path.join(workdir, d) for d in os.listdir(workdir) if d.startswith("haproxy-"))
        self.orig = src
        self.root = os.path.join(root, os.path.basename(src))
        if not os.path.isdir(self.root):
            shutil.copytree(src, self.root, symlinks=True)
        self._pristine = {}

    def pristine(self, rel):
        if rel not in self._pristine:
            with open(os.path.join(self.orig, rel), encoding="utf-8", errors="surrogateescape", newline="") as fh:
                self._pristine[rel] = fh.read()
        return self._pristine[rel]

    def path(self, rel):
        return os.path.join(self.root, rel)

    def apply(self, overlay):
        for rel, text in overlay.items():
            with open(self.path(rel), "w", encoding="utf-8", errors="surrogateescape", newline="") as fh:
                fh.write(text)

    def revert(self, overlay):
        self.apply({rel: self.pristine(rel) for rel in overlay})

    def diff(self, overlay):
        """Cumulative unified diff (patch -p1) of an overlay against the buggy tree."""
        out = []
        for rel in sorted(overlay):
            a, b = self.pristine(rel), overlay[rel]
            if a != b:
                out.extend(difflib.unified_diff(a.splitlines(keepends=True), b.splitlines(keepends=True),
                                                f"a/{rel}", f"b/{rel}"))
        return "".join(l if l.endswith("\n") else l + "\n\\ No newline at end of file\n" for l in out)


class LLM:
    """OpenAI-compatible client handed to upstream (LLMRepair.client): retries, logs every
    exchange, and falls back from JSON-schema output when the server rejects it."""

    def __init__(self, out_dir, model, base_url, api_key, temperature, json_schema, replay):
        self.dir = os.path.join(out_dir, "llm")
        os.makedirs(self.dir, exist_ok=True)
        self.n = len(os.listdir(self.dir))
        self.model, self.temperature, self.json_schema, self.replay = model, temperature, json_schema, replay
        self.real = None
        if not replay:
            import openai
            self.openai = openai
            self.real = openai.OpenAI(base_url=base_url, api_key=api_key or "none", timeout=3600, max_retries=0)
        self.chat = types.SimpleNamespace(completions=types.SimpleNamespace(create=self.create))

    def _replay(self, kw):
        name = kw.get("response_format", {}).get("json_schema", {}).get("name", "")
        prompt = kw["messages"][-1]["content"]
        if name == "repair_sequence_generation":
            return json.dumps({"sequence": "{1,[ADD],2}", "explanation": "replay"})
        func = prompt.rsplit("// Vulnerable Function\n", 1)[-1].split("\n\nLet's think", 1)[0]
        lines = func.split("\n")
        at = next((i for i, l in enumerate(lines) if "{" in l), 0)
        lines.insert(at + 1, "\t/* looprepair replay */")
        return json.dumps({"patch_function": "\n".join(lines), "explanation": "replay"})

    def create(self, **kw):
        kw = dict(kw)
        kw["model"] = self.model
        if self.temperature is not None:
            kw["temperature"] = self.temperature
        rec = {"request": kw}
        t0 = time.time()
        try:
            if self.replay:
                content = rec["response"] = self._replay(kw)
                return types.SimpleNamespace(choices=[types.SimpleNamespace(message=types.SimpleNamespace(content=content))])
            last = None
            for attempt in range(4):
                send = dict(kw)
                if not self.json_schema and "response_format" in send:
                    schema = send.pop("response_format")["json_schema"]["schema"]
                    send["messages"] = send["messages"] + [{
                        "role": "user",
                        "content": "Answer with only a JSON object with the string fields "
                                   + ", ".join(schema["required"]) + "."}]
                try:
                    r = self.real.chat.completions.create(**send)
                    rec["response"] = r.choices[0].message.content
                    return r
                except self.openai.BadRequestError as e:
                    last = e
                    if self.json_schema and "response_format" in send:
                        log(f"server rejected JSON-schema output ({e}); falling back to a JSON instruction")
                        self.json_schema = False
                        continue
                    raise
                except (self.openai.APIConnectionError, self.openai.APITimeoutError,
                        self.openai.RateLimitError, self.openai.InternalServerError) as e:
                    last = e
                    time.sleep(10 * (attempt + 1))
            raise last
        except Exception as e:
            rec["error"] = f"{type(e).__name__}: {e}"
            raise
        finally:
            rec["seconds"] = round(time.time() - t0, 1)
            if "response" not in rec and self.replay:
                rec["response"] = "(replay)"
            with open(os.path.join(self.dir, f"{self.n:04d}.json"), "w") as fh:
                json.dump(rec, fh, indent=1, default=str)
            self.n += 1


def passing_spectrum(results):
    """ep[(file, line)] over the passing tests of the buggy version, and P."""
    _, passing = fl.load_tests(results)
    ep = collections.Counter()
    for t in passing:
        ep.update(fl.load_coverage(os.path.join(results, t["coverage"])))
    return ep, len(passing)


def line_map(old, new):
    """old line number -> new line number for unchanged lines (1-based)."""
    m = {}
    sm = difflib.SequenceMatcher(None, old.split("\n"), new.split("\n"), autojunk=False)
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            for k in range(i2 - i1):
                m[i1 + k + 1] = j1 + k + 1
    return m


class LoopRepair:
    def __init__(self, args, bug, L, tree, box, out_dir):
        self.args, self.bug, self.L, self.tree, self.box, self.out = args, bug, L, tree, box, out_dir
        self.t0 = time.time()
        self.stash = []           # (file path, patched file text | None), in upstream's candidate order
        self.n_cand = 0
        self.found = []
        self.evaluated = 0
        self.ep, self.P = passing_spectrum(args.results)
        # original full-spectrum Ochiai (all failing tests): tie-break of the re-localization
        spec, failing, _ = fl.build_spectrum(args.results)
        F = len(failing)
        self.ochiai0 = {k: (ef / math.sqrt(F * (ef + ep)) if ef else 0.0) for k, (ef, ep, _nf, _np) in spec.items()}
        os.makedirs(os.path.join(out_dir, "generated"), exist_ok=True)
        os.makedirs(os.path.join(out_dir, "candidates"), exist_ok=True)
        self.evlog = open(os.path.join(out_dir, "evaluations.jsonl"), "a")
        up_generate = L.generate_candidates
        up_predict = L.Predict_sequence

        def generate_candidates(patch, source_file_path, start_line, end_line, first_indent):
            if patch is None:  # upstream patch_generation returns None when the LLM call failed
                self.stash.append((source_file_path, None))
                return ""
            with open(source_file_path, "r", encoding="utf-8") as fh:
                lines = fh.read().split("\n")
            new = lines[0:start_line] + [first_indent + l for l in patch.split("\n")] + lines[end_line + 1:]
            self.stash.append((source_file_path, "\n".join(new)))
            return up_generate(patch, source_file_path, start_line, end_line, first_indent)

        def predict_sequence(function, number, line):
            try:
                return up_predict(function=function, number=number, line=line)
            except Exception as e:  # upstream does not catch here; one failed call would abort the round
                log(f"sequence prediction failed ({type(e).__name__}); continuing without a sequence")
                return ""

        L.generate_candidates = generate_candidates
        L.Predict_sequence = predict_sequence

    def left(self):
        return self.args.iterative_minutes * 60 - (time.time() - self.t0)

    # ---- generation (upstream LLMRepair) -> candidates as overlays
    def generate(self, locations, base, iteration):
        """locations: [{"location": "<W path>:<line>", "constraint": str}]"""
        self.tree.apply(base["overlay"])
        self.stash = []
        out_json = os.path.join(self.out, "work", f"candidates-{iteration}-{base['id']}.json")
        try:
            if iteration == 0:
                loc_json = os.path.join(self.out, "work", "localization.json")
                with open(loc_json, "w") as fh:
                    json.dump(locations, fh, indent=1)
                self.L.generate_use_llms_from_localization_path(loc_json, out_json)
            else:
                self.L.generate_use_llms_from_localization_list(locations, self.orig_sig, out_json)
        finally:
            self.tree.revert(base["overlay"])
        up = json.load(open(out_json)) if os.path.exists(out_json) else []
        if len(up) != len(self.stash):
            raise SystemExit(f"internal: upstream produced {len(up)} candidates, {len(self.stash)} captured")
        cands = []
        for u, (path, text) in zip(up, self.stash):
            self.n_cand += 1
            cid = f"c{self.n_cand:03d}"
            if text is None:
                continue
            overlay = dict(base["overlay"])
            overlay[os.path.relpath(path, self.tree.root)] = text
            diff = self.tree.diff(overlay)
            with open(os.path.join(self.out, "generated", f"{cid}.patch"), "w") as fh:
                fh.write(diff)
            cands.append({"id": cid, "overlay": overlay, "location": u["location"], "base": base["id"],
                          "iteration": iteration, "diff": diff})
        return cands

    # ---- upstream Scenario.validate (+ analyze_for_guide on failure)
    def validate(self, cands):
        t_start = time.time()
        evaluations, repaired = [], False
        for c in cands:
            if time.time() - t_start >= self.args.validation_minutes * 60 or self.left() <= 0:
                log("reached candidate patch evaluation time limit")
                break
            if len(self.found) >= self.args.patch_limit:
                log(f"reached acceptable patch limit ({self.args.patch_limit})")
                break
            if not c["diff"].strip():
                ev = {"compiles": None, "acceptable": False, "note": "no change"}
            else:
                ev = self.box.evaluate(c["overlay"], self.args.test_timeout)
                self.evaluated += 1
            rec = {k: c[k] for k in ("id", "iteration", "base", "location")} | ev
            self.evlog.write(json.dumps(rec) + "\n")
            self.evlog.flush()
            log(f"  {c['id']} ({c['location'].split(self.tree.root + '/')[-1]}): "
                + ("no change" if ev.get("note") else "does not compile" if not ev["compiles"]
                   else f"trigger {ev['trigger']}" + (f", relevant {ev['relevant']}" if ev["trigger"] == "pass" else "")))
            evaluations.append((c, ev))
            if ev["acceptable"]:
                repaired = True
                shutil.copy(os.path.join(self.out, "generated", f"{c['id']}.patch"),
                            os.path.join(self.out, "candidates", f"{c['id']}.patch"))
                self.found.append(c["id"])
                if not self.args.no_stop_early:
                    log("stopping search: patch was found")
                    break
        analyses = []
        if not repaired:
            for c, ev in evaluations[:20]:
                if ev.get("compiles"):
                    analyses.append(self.analyze_for_guide(c))
                else:
                    analyses.append(c | {"impact_lines": -1, "vulnerability_type": "", "localization_result": []})
        return repaired, analyses

    def analyze_for_guide(self, c):
        covered, sig = self.box.trace(c["overlay"])
        if covered is None:
            return c | {"impact_lines": -1, "vulnerability_type": "", "localization_result": []}
        return c | {"impact_lines": float(len(covered)), "vulnerability_type": sig,
                    "localization_result": self.relocalize(covered, c["overlay"], sig)}

    def relocalize(self, covered, overlay, sig, top=2):
        """Ochiai on the patched program: failing = the trigger's coverage (F = 1), passing =
        the original passing tests with lines mapped through the patch."""
        maps, changed = {}, {}
        for rel, text in overlay.items():
            old = self.tree.pristine(rel)
            maps[rel] = line_map(old, text)
            kept = set(maps[rel].values())
            changed[rel] = [n for n in range(1, text.count("\n") + 2) if n not in kept]
        def mapped(counter):
            out = collections.Counter()
            for (f, ln), n in counter.items():
                if f not in maps:
                    out[(f, ln)] += n
                elif ln in maps[f]:
                    out[(f, maps[f][ln])] += n
            return out

        ep = mapped(self.ep)
        o0 = mapped(self.ochiai0)

        def key(k):
            f, ln = k
            dist = min((abs(ln - x) for x in changed.get(f, [])), default=10 ** 9)
            # Ochiai on the patched program; ties: patched files, nearest the change, then the
            # original program's Ochiai, then file/line
            return (-1.0 / math.sqrt(1 + ep[k]), f not in overlay, dist, -o0[k], f, ln)

        self.tree.apply(overlay)
        try:
            out = []
            for f, ln in sorted(covered, key=key):
                if not f.endswith((".c", ".h")) or not os.path.exists(self.tree.path(f)):
                    continue
                try:
                    if not self.L.get_function_from_file(self.tree.path(f), ln):
                        continue
                except Exception:
                    continue
                out.append({"location": f"{self.tree.path(f)}:{ln}", "constraint": sig})
                if len(out) >= top:
                    break
            return out
        finally:
            self.tree.revert(overlay)

    # ---- upstream Scenario.iterative_repair
    def iterate(self, pool):
        for iteration in range(self.args.max_iterations):
            if self.left() <= 0:
                log("iterative time limit reached")
                return False
            pool = [c for c in pool if not (c["vulnerability_type"] and c["vulnerability_type"] != self.orig_sig)]
            if not any(c["impact_lines"] != 0.0 for c in pool):
                pool = pool[:5]
            else:
                pool = sorted(pool, key=lambda c: c["impact_lines"], reverse=True)
            pool = [c for c in pool if c["localization_result"]]
            pool = sorted(pool, key=lambda c: c["impact_lines"], reverse=True)[:2]
            if not pool:
                log(f"iteration {iteration + 1}: no test-failing patch to build on")
                return False
            nxt = list(pool)
            for base in pool:
                log(f"iteration {iteration + 1}: base {base['id']} (trace {int(base['impact_lines'])} lines), "
                    f"locations {[l['location'].split(self.tree.root + '/')[-1] for l in base['localization_result'][:2]]}")
                cands = self.generate(base["localization_result"][:2], base, iteration + 1)
                repaired, analyses = self.validate(cands)
                if repaired:
                    return True
                nxt += analyses
            pool = nxt
        return False

    def run(self):
        # "analysis" of the original program: trigger signature, then FL locations
        base = {"id": "orig", "overlay": {}}
        ev = self.box.evaluate({}, self.args.test_timeout)
        if not ev["compiles"] or ev["trigger"] != "fail":
            raise SystemExit(f"baseline check failed: buggy tree must compile and fail the trigger ({ev})")
        self.orig_sig = ev["signature"]
        log(f"trigger fails on the buggy tree: {self.orig_sig}")
        tool, _, formula = self.args.fl.partition(":")
        p = os.path.join(self.args.results, "fl", tool, "ranking.json")
        if not os.path.exists(p):
            raise SystemExit(f"--fl {self.args.fl}: {p} not found (cvebench fl -t {tool})")
        fs = json.load(open(p))["formulas"]
        formula = formula or next(iter(fs))
        locs = []
        for r in fs[formula]["top"]:
            path = self.tree.path(r["file"])
            if r["file"].endswith((".c", ".h")) and os.path.exists(path) and self.L.get_function_from_file(path, int(r["line"])):
                locs.append({"location": f"{path}:{r['line']}", "constraint": self.orig_sig})
            if len(locs) >= self.args.fl_top:
                break
        log(f"fix localization ({tool}:{formula}): {[l['location'].split(self.tree.root + '/')[-1] for l in locs]}")
        cands = self.generate(locs, base, 0)
        log(f"round 0: {len(cands)} candidate(s)")
        repaired, analyses = self.validate(cands)
        if not repaired:
            repaired = self.iterate(analyses)
        return repaired


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("results")
    ap.add_argument("workdir")
    ap.add_argument("-o", "--out-dir", required=True)
    ap.add_argument("--fl", default="sbfl:ochiai", metavar="TOOL[:FORMULA]",
                    help="fix localization: top lines of results/<bug>/fl/TOOL/ranking.json")
    ap.add_argument("--fl-top", type=int, default=3, help="locations in the first round (5 samples each)")
    ap.add_argument("--model", default=os.getenv("LOOPREPAIR_MODEL"))
    ap.add_argument("--base-url", default=os.getenv("OPENAI_BASE_URL"))
    ap.add_argument("--temperature", type=float, default=None)
    ap.add_argument("--no-json-schema", action="store_true",
                    help="the server does not support response_format json_schema")
    ap.add_argument("--max-iterations", type=int, default=3)
    ap.add_argument("--validation-minutes", type=int, default=45, help="per validation round (upstream default)")
    ap.add_argument("--iterative-minutes", type=int, default=180, help="whole run (upstream iterative limit)")
    ap.add_argument("--test-timeout", type=int, default=60)
    ap.add_argument("--patch-limit", type=int, default=10)
    ap.add_argument("--no-stop-early", action="store_true")
    ap.add_argument("--replay", action="store_true", help="no LLM: pipeline self-test")
    args = ap.parse_args()

    if not os.access(os.path.join(VENV, "bin", "python"), os.X_OK) or not os.path.isdir(UPSTREAM_SRC):
        raise SystemExit(f"looprepair not prepared — run {HERE}/prepare.sh (cvebench prepare -t looprepair)")
    if os.path.realpath(sys.prefix) != os.path.realpath(VENV):  # re-exec inside the venv
        os.execv(os.path.join(VENV, "bin", "python"), [os.path.join(VENV, "bin", "python"), os.path.abspath(__file__)] + sys.argv[1:])
    args.results = os.path.abspath(args.results)
    if not os.path.exists(os.path.join(args.results, "tests.json")):
        raise SystemExit("no coverage for this bug — run `cvebench coverage` first (re-localization uses it)")

    out_dir = os.path.abspath(args.out_dir)
    os.makedirs(os.path.join(out_dir, "work"), exist_ok=True)
    bug = sb.Bug(os.path.abspath(args.workdir))
    bug.ensure_image("looprepair")
    model = "replay" if args.replay else args.model or (
        sb.default_model(args.base_url, prefix="") if args.base_url else "gpt-4o-mini")

    # upstream LLM stage: relative paths (../prompt, ../tree-sitter) resolve from its directory
    os.environ.setdefault("OPENAI_API_KEY", "none")
    os.chdir(UPSTREAM_SRC)
    sys.path.insert(0, UPSTREAM_SRC)
    from loguru import logger
    logger.remove()
    logger.add(os.path.join(out_dir, "looprepair.log"), level="DEBUG")
    import LLMRepair as L
    L.client = LLM(out_dir, model, args.base_url, os.getenv("OPENAI_API_KEY"), args.temperature,
                   not args.no_json_schema, args.replay)
    L.api_model = model

    tree = Tree(os.path.abspath(args.workdir), os.path.join(out_dir, "work"))
    box = Sandbox(bug, os.path.join(out_dir, "sandbox"), tree, args.iterative_minutes * 60)
    log(f"{bug.name}: model {model}, fl {args.fl} top {args.fl_top}, ≤{args.max_iterations} iterations, "
        f"≤{args.iterative_minutes} min")
    t0 = time.time()
    status = "error"
    lr = None
    try:
        lr = LoopRepair(args, bug, L, tree, box, out_dir)
        status = "patch found" if lr.run() else "no patch"
    finally:
        box.close()
        summary = {"status": status, "seconds": int(time.time() - t0), "model": model, "fl": args.fl,
                   "fl_top": args.fl_top, "max_iterations": args.max_iterations,
                   "candidates_generated": lr.n_cand if lr else 0, "candidates_evaluated": lr.evaluated if lr else 0,
                   "llm_calls": L.client.n, "acceptable": lr.found if lr else [],
                   "trigger_signature": getattr(lr, "orig_sig", None)}
        json.dump(summary, open(os.path.join(out_dir, "looprepair.json"), "w"), indent=2)
        log(f"{status}: {summary['candidates_generated']} generated, {summary['candidates_evaluated']} evaluated, "
            f"{summary['llm_calls']} LLM calls, {summary['seconds']}s"
            + (f" -> {', '.join('candidates/' + c + '.patch' for c in summary['acceptable'])}" if summary["acceptable"] else ""))


if __name__ == "__main__":
    main()
