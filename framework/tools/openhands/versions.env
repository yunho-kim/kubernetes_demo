# Upstream of the OpenHands adapter (installed from PyPI at the versions in requirements.txt).
OPENHANDS_SDK_REPO=https://github.com/OpenHands/software-agent-sdk
OPENHANDS_SDK_VERSION=1.50.0
# The instruction template follows OpenHands' SWE-bench evaluation prompt
# (https://github.com/OpenHands/benchmarks, benchmarks/swebench/prompts/default.j2 @ 405bae71),
# adapted to a C program with a failing regression test instead of a GitHub issue.
OPENHANDS_BENCHMARKS_COMMIT=405bae7140d7e961a75f4910a0b2e7069731db96
