# Upstream reference for the COSMosFL adapter (protocol, prompt and aggregation ported from this commit).
COSMOSFL_REPO=https://github.com/coinse/cosmosfl
COSMOSFL_COMMIT=4defdc053cc6b6cfb21616aeae07f7c01e64ae8c
# The paper's final ensemble (4-bit models served by Ollama) and runs per model (R_m = 5, R = 20).
COSMOSFL_MODELS=llama3,llama3.1,mistral-nemo,qwen2.5-coder
COSMOSFL_REPS=5
