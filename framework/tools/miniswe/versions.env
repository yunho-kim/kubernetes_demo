# Upstream of the mini-swe-agent adapter (installed from PyPI at the version in requirements.in).
MSWEA_REPO=https://github.com/SWE-agent/mini-swe-agent
MSWEA_VERSION=2.4.6
# Interpreter of the adapter's venv: exact CPython (python-build-standalone, installed by uv into
# framework/.python/ — never the system Python); framework/lib/pyenv.sh, docs/INTEGRATION.md 6.
# (the interpreter its venv was built with)
PYTHON_VERSION=3.13.5
