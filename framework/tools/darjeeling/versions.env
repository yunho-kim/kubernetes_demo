# Darjeeling adapter: upstream and the Kaskara C/C++ backend it indexes C statements with.
DARJEELING_REPO=https://github.com/squaresLab/Darjeeling
DARJEELING_COMMIT=81803f1dd31f438e71b5fdbf7e18157b3dbe35d8
KASKARA_COMMIT=f8f49db12f04e5c4f482a1ea94b767b701710afe   # = Darjeeling's poetry.lock
# built by prepare.sh from kaskara's own backend/Dockerfile (FROM christimperley/llvm18;
# not published on Docker Hub); kaskara's post_install copies its /opt/kaskara into the
# docker volume kaskara-clang, which Darjeeling mounts into the program container to
# index C statements with clang.
KASKARA_IMAGE=christimperley/kaskara:cpp
