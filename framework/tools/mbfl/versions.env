# Pinned toolchain for the Mull-instrumented build (sourced by prepare.sh and run).
# Mull publishes one .deb per LLVM major and distro; debian-13 (trixie) builds
# exist for LLVM 17/18/19 — trixie ships clang-19 natively, so use that.
LLVM=19
MULL_VERSION=0.34.0
MULL_LLVM_FULL=19.1.7
BASE_IMAGE=cvebench-mull:llvm${LLVM}-${MULL_VERSION}
