# Faithful Defects4J-style minimal pair: build the FIXED release from source,
# and for VARIANT=buggy reverse-apply the upstream fix patch so buggy and fixed
# differ by EXACTLY the fix. Coverage-instrumented; bundles gdb+gcovr (per-test
# coverage) and vtest (to run HAProxy's own reg-tests/ suite).
FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc make libc6-dev wget ca-certificates bash curl git patch \
        gdb python3-pip \
        libpcre2-dev pkg-config zlib1g-dev \
    && pip3 install --break-system-packages --no-cache-dir 'gcovr==7.2' \
    && rm -rf /var/lib/apt/lists/*

# vtest (VTest) — the harness that runs HAProxy's reg-tests/*.vtc. Built early so
# it stays cached across all CVE image builds.
RUN git clone --depth 1 https://github.com/vtest/VTest.git /opt/VTest \
    && make -C /opt/VTest -j"$(nproc)" \
    && cp /opt/VTest/vtest /usr/local/bin/vtest

ARG HAPROXY_VERSION
ARG VARIANT=fixed
ARG FIX_PATCH
ARG EXTRA_MAKE=
# APR: an optional candidate patch applied on top of the variant (cvebench validate)
ARG CANDIDATE_PATCH=build/empty.patch
WORKDIR /build
RUN BR="$(echo "$HAPROXY_VERSION" | cut -d. -f1,2)" \
    && wget -q "https://www.haproxy.org/download/${BR}/src/haproxy-${HAPROXY_VERSION}.tar.gz" \
    && tar xzf "haproxy-${HAPROXY_VERSION}.tar.gz" && rm -f "haproxy-${HAPROXY_VERSION}.tar.gz"
COPY "$FIX_PATCH" /tmp/fix.patch

WORKDIR /build/haproxy-${HAPROXY_VERSION}
# buggy = fixed release with the fix reverse-applied (minimal pair)
RUN if [ "$VARIANT" = "buggy" ]; then \
        echo "== reverse-applying fix to create BUGGY ==" && patch -R -p1 < /tmp/fix.patch ; \
    else echo "== FIXED variant (no patch) ==" ; fi
COPY "$CANDIDATE_PATCH" /tmp/candidate.patch
RUN if [ -s /tmp/candidate.patch ]; then \
        echo "== applying CANDIDATE patch ==" && patch -p1 --no-backup-if-mismatch < /tmp/candidate.patch ; fi
RUN make -j"$(nproc)" TARGET=linux-glibc \
        USE_OPENSSL= USE_PCRE= USE_PCRE2= USE_ZLIB= USE_LUA= USE_SYSTEMD= \
        CPU_CFLAGS="-O0" \
        DEBUG_CFLAGS="-g3 -fno-inline -fprofile-arcs -ftest-coverage" \
        LDFLAGS="-fprofile-arcs -ftest-coverage" \
        $EXTRA_MAKE \
    && cp haproxy /usr/local/bin/haproxy && ./haproxy -v | head -1

# Install the gcov-flush wrapper as `haproxy` (real binary -> haproxy.real).
# Added last so the expensive compile layer stays cached.
COPY build/cov-flush-wrapper.sh /tmp/cov-flush-wrapper.sh
RUN mv /usr/local/bin/haproxy /usr/local/bin/haproxy.real \
    && install -m 0755 /tmp/cov-flush-wrapper.sh /usr/local/bin/haproxy

ENV HAPROXY_SRC=/build/haproxy-${HAPROXY_VERSION}
WORKDIR /build/haproxy-${HAPROXY_VERSION}
CMD ["sleep", "infinity"]
