varnishtest "CVE-2022-0711 — Set-Cookie2 must not loop forever"
# Trigger: FAILS on buggy, PASSES on fixed.
#   buggy : backend's 'Set-Cookie2' makes http_manage_server_side_cookies() spin
#           forever -> no response (the coverage build has no thread watchdog, so
#           it hangs and the gcov-flush wrapper dumps it on stop)
#   fixed : the loop terminates -> 200 with body
feature ignore_unknown_macro

server s1 {
    rxreq
    txresp -hdr "Set-Cookie2: X=Y; Discard" -body "BACKEND-OK"
} -start

haproxy h1 -conf {
    defaults
        mode http
        timeout connect 2s
        timeout client  2s
        timeout server  2s
    frontend fe
        bind "fd@${fe}"
        default_backend be
    backend be
        cookie SERVERID insert indirect nocache
        server s1 ${s1_addr}:${s1_port} cookie s1
} -start

client c1 -connect ${h1_fe_sock} {
    txreq -req GET -url /
    rxresp
    expect resp.status == 200
    expect resp.body == "BACKEND-OK"
} -run
